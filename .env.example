# Environment Configuration for asiix.vn

# Site metadata
SITE_URL=https://asiix.vn
SITE_NAME=asiix Official Website

# Build
NODE_ENV=production

# Image optimization
IMAGE_OPTIMIZATION=true
MAX_IMAGE_WIDTH=1200
MAX_IMAGE_HEIGHT=1200

# Performance
ENABLE_COMPRESSION=true
ENABLE_MINIFICATION=true
ENABLE_PREFETCH=true

# YouTube
YOUTUBE_VIDEO_ID=05SC7-A_uak

# Analytics (optional)
# GOOGLE_ANALYTICS_ID=

# Third-party integrations
# INSTAGRAM_USERNAME=
# FACEBOOK_PAGE_ID=
