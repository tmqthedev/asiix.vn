---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/profile.css"
---

<BaseLayout title="asiix: Profile">
    <h1 class="title">Profile</h1>
    <div class="profile-container">
        <div class="profile-content">
            <div class="profile_img">
                <div class="color_bg artist_crbg"></div>
                <div class="artist_img">
                    <img src="/images/profile/congb.jpg" alt="CONGB" width="455" height="580" loading="eager" decoding="async" fetchpriority="high">
                </div>
            </div>
            <div class="profile-info">
                <h1 class="profile-name">CONGB</h1>
                <div class="profile-details">
                    <p>DOB: 2000.12.08</p>
                </div>
            </div>
        </div>
    </div>
</BaseLayout>